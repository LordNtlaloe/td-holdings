# ─────────────────────────────────────────────────────────────────────
# Database — the connection is built from these two variables alone.
#
#   Turso (remote):  TURSO_DATABASE_URL="libsql://<db>.turso.io"
#                    TURSO_AUTH_TOKEN=<token>
#   Local file:      TURSO_DATABASE_URL="file:./local.db"
#
# For a local file, `file:` paths are resolved against the repo root, and
# `npm run db:bootstrap` creates + seeds it from `convex-export/`.
# ─────────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# Sign-in passwords
#
# Accounts imported from Convex have no password hashes, so they cannot sign in
# until one is set. There is deliberately no CLI/env way to do that any more —
# an admin sets passwords from the app: sidebar → Users → row menu → Set
# Password (PATCH /api/users/:id/password). The password is hashed server-side
# and never written to a log.
# ─────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────
# API server (Hono, mounted at /api/* by the same process as the UI)
# ─────────────────────────────────────────────────────────────────────
# Only used by `npm run dev:api`, which runs the API standalone.
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Secret used to sign auth JWTs (use a long random string)
JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Frontend
# Leave empty to talk to the API on the same origin (the normal case, since the
# API and the UI are served by one process). Only set this if the API lives
# somewhere else.
# ─────────────────────────────────────────────────────────────────────
VITE_API_URL=

# ─────────────────────────────────────────────────────────────────────
# Email (optional — used to send password reset codes)
# ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Printing — the Fly.io relay (unchanged from the original Convex setup)
#
# Receipts are rendered to ESC/POS bytes by the API and POSTed to
# `${RELAY_URL}/print/<agentId>`, where `agentId` is the store's
# `print_agent_id`. The relay forwards the bytes over WebSocket to the
# matching Electron till agent, which writes them to the thermal printer.
#
#   RELAY_URL    = https://td-print-relay.fly.dev
#   RELAY_SECRET = <the same secret the relay + till agents use>
#
# Both must be set or printing fails. The health probe used by the store
# settings page calls `${RELAY_URL}/health` and expects
# `{ "connectedAgents": ["<agentId>", ...] }`.
# ─────────────────────────────────────────────────────────────────────
RELAY_URL=
RELAY_SECRET=
