{
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".output",
    ".vercel",
    // The API (`src/api/**`) and the custom server entry (`src/server.ts`) are
    // Node-only and are type-checked by `tsconfig.api.json` instead. They live
    // under `src/` so the app is one source tree, but compiling them with this
    // config's DOM/JSX settings produced ~60 spurious errors.
    "src/api",
    "src/server.ts",
    "scripts",
    "drizzle.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
